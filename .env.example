# Salin ke .env dan isi nilai sebenar. JANGAN commit .env.
SECRET_KEY=rahsia-random-anda

# Brevo SMTP relay — dashboard.brevo.com → SMTP & API → SMTP key
BREVO_SMTP_USER=email-login-smtp-anda@example.com
BREVO_SMTP_KEY=xsmtpkey-anda
MAIL_FROM="Nama Anda <email@domain-anda.com>"

# Telegram bot — @BotFather
TELEGRAM_BOT_TOKEN=

# URL public untuk link unsubscribe (tukar bila deploy)
PUBLIC_BASE_URL=http://localhost:5558

# Rate cap per jam (Brevo free = 300/hari; letak 300 pun selamat)
EMAIL_RATE_PER_HOUR=300
TELEGRAM_RATE_PER_HOUR=25

# Local LLM untuk AI copy drafts (F1 hook, belum wajib)
LLM_URL=http://localhost:8080
