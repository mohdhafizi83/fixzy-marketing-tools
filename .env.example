# Copy to .env and fill in real values. NEVER commit .env.
SECRET_KEY=your-random-flask-secret

# Brevo SMTP relay — dashboard.brevo.com -> SMTP & API -> SMTP key
BREVO_SMTP_USER=your-smtp-login-email@example.com
BREVO_SMTP_KEY=your-xsmtpkey
MAIL_FROM="Your Name <you@yourdomain.com>"

# Telegram bot — create via @BotFather
TELEGRAM_BOT_TOKEN=

# Twilio SMS (preferred SMS backend; ~RM0.04-0.10/msg to MY)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# RedSMS MY (fallback; verify API format against your account docs first)
REDSMS_USERNAME=
REDSMS_PASSWORD=
REDSMS_SENDER_ID=Fixzy

# WhatsApp Cloud API (Meta) — reply-only by design (24h window).
# developers.facebook.com -> your app -> WhatsApp product
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Messenger (FB Page) + Instagram Direct — reply-only (24h window).
# Both share ONE webhook: /webhooks/meta with the verify token below.
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# X (Twitter) — publish/monitor only (pay-per-use, developer.x.com)
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=

# Admin login for the UI (required before any public exposure)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Search API for lead discovery (one of these; SerpAPI preferred)
SERPAPI_KEY=
SEARXNG_URL=
# Public URL used in unsubscribe links (change when deployed)
PUBLIC_BASE_URL=http://localhost:5558

# Rate cap per hour (Brevo free tier = 300/day; 300/hr is still safe)
EMAIL_RATE_PER_HOUR=300
TELEGRAM_RATE_PER_HOUR=25

# Local LLM for AI copy drafts (F1 hook, not required yet)
LLM_URL=http://localhost:8080
